Bootstrap: docker
From: nvcr.io/nvidia/dgl:23.07-py3

%labels
    org.opencontainers.image.source https://github.com/RosettaCommons/RFdiffusion
    org.opencontainers.image.revision 86507b6538f51fce57b5a72477165f03999ed7ae
    org.opencontainers.image.title RFdiffusion ARM64 runtime for Isambard GH200
    org.opencontainers.image.architecture arm64
    org.opencontainers.image.base.name nvcr.io/nvidia/dgl:23.07-py3

%files
    build-context/RFdiffusion /app/RFdiffusion

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    export PIP_NO_CACHE_DIR=1
    export DGLBACKEND=pytorch
    apt-get update
    apt-get install --no-install-recommends -y git ca-certificates wget
    rm -rf /var/lib/apt/lists/*
    python -m pip install --no-cache-dir \
        e3nn==0.3.3 \
        wandb==0.12.0 \
        pynvml==11.0.0 \
        decorator==5.1.0 \
        hydra-core==1.3.2 \
        pyrsistent==0.19.3 \
        git+https://github.com/NVIDIA/dllogger#egg=dllogger
    python -m pip install --no-cache-dir /app/RFdiffusion/env/SE3Transformer
    python -m pip install --no-cache-dir --no-deps /app/RFdiffusion
    mkdir -p /app/RFdiffusion/models /app/RFdiffusion/outputs /app/RFdiffusion/inputs
    chmod -R a+rX /app/RFdiffusion

%environment
    export DGLBACKEND=pytorch
    export PYTHONPATH=/app/RFdiffusion:${PYTHONPATH:-}
    export HYDRA_FULL_ERROR=1

%runscript
    cd /app/RFdiffusion
    exec python scripts/run_inference.py "$@"

%test
    cd /app/RFdiffusion
    python -c "import platform, torch, dgl, e3nn, se3_transformer, rfdiffusion; assert platform.machine() == 'aarch64'; print(torch.__version__, dgl.__version__, e3nn.__version__)"
