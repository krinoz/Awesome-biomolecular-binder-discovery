Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.06-py3

%labels
    org.opencontainers.image.title Chai-1 inference runtime for Isambard GH200
    org.opencontainers.image.source https://github.com/chaidiscovery/chai-lab
    org.opencontainers.image.revision 66c38d1fe5c6756a89ff8596b1dea87d305ec06f
    org.opencontainers.image.architecture arm64
    org.opencontainers.image.note Runtime only; official Chai-1 components, conformers, and traced ESM-2 3B are external read-only mounts

%files
    build-context/chai-lab-66c38d1.tar.gz /opt/chai-lab.tar.gz
    build-context/chai1_run.py /opt/chai1/chai1_run.py

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export PIP_CONFIG_FILE=/dev/null
    export PIP_INDEX_URL=https://pypi.org/simple
    unset PIP_EXTRA_INDEX_URL
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git ca-certificates curl kalign \
        libgomp1 libgl1 libglib2.0-0 python3-venv
    rm -rf /var/lib/apt/lists/*

    mkdir -p /opt/chai-lab /opt/chai1 /models /work/cache /work/results
    tar --no-same-owner --strip-components=1 -xzf /opt/chai-lab.tar.gz -C /opt/chai-lab
    rm -f /opt/chai-lab.tar.gz
    python3 -m venv --system-site-packages /opt/envs/chai1
    /opt/envs/chai1/bin/pip install --no-cache-dir --upgrade 'pip<26' 'setuptools<81' wheel
    /opt/envs/chai1/bin/pip install --no-cache-dir \
        'typer~=0.12' 'tqdm~=4.66' typing-extensions matplotlib \
        'gemmi~=0.7.5' rdkit==2025.9.6 'biopython>=1.83' antipickle==0.2.0 \
        'tmtools>=0.0.3' 'modelcif>=1.0' 'numpy>=1.26,<2.1' \
        'pandas>=2.1,<3' pyarrow 'pandera>=0.24' 'numba>=0.59' \
        'einops~=0.8' 'jaxtyping>=0.2.25' 'beartype>=0.18' \
        requests filelock aiohttp
    /opt/envs/chai1/bin/pip install --no-cache-dir --no-deps /opt/chai-lab
    chmod -R a+rX /opt/chai-lab /opt/chai1 /opt/envs/chai1
    chmod -R a+rwx /work
    rm -rf /root/.cache/pip

%environment
    export PYTHONPATH=/opt/chai-lab:$PYTHONPATH
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONNOUSERSITE=1
    export CHAI_DOWNLOADS_DIR=/models
    export MPLCONFIGDIR=/work/cache/matplotlib
    export XDG_CACHE_HOME=/work/cache
    export TMPDIR=/tmp

%runscript
    exec /opt/envs/chai1/bin/python /opt/chai1/chai1_run.py "$@"

%test
    /opt/envs/chai1/bin/python -c 'import platform, torch, chai_lab; assert platform.machine()=="aarch64"; assert torch.version.cuda; print(chai_lab.__version__)'
    /opt/envs/chai1/bin/python /opt/chai1/chai1_run.py --help >/dev/null
