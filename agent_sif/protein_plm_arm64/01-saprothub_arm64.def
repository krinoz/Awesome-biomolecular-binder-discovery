Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.06-py3

%labels
    org.opencontainers.image.title SaProtHub selected-model inference and LoRA runtime for Isambard GH200
    org.opencontainers.image.source https://github.com/westlake-repl/SaProtHub
    org.opencontainers.image.revision 2f39673a37e0b35f83788dcf8ef5ad326a42871c
    org.opencontainers.image.architecture arm64
    org.opencontainers.image.models ColabSaProt-35M,ColabSaProt-650M,ColabESM2-35M,ColabESM2-150M,ColabESM2-650M
    org.opencontainers.image.note Official inference, Foldseek 3Di structure encoding, and bounded LoRA fine-tuning; revision-pinned external read-only model snapshots; no unrequested models or databases

%files
    build-context/SaProtHub-selected-2f39673a.tar.gz /opt/SaProtHub-selected.tar.gz
    build-context/saprothub_forward.py /opt/saprothub/saprothub_forward.py
    build-context/saprothub_extract_3di.py /opt/saprothub/saprothub_extract_3di.py
    build-context/saprothub_finetune.py /opt/saprothub/saprothub_finetune.py

%post
    set -eux
    export PIP_CONFIG_FILE=/dev/null
    export PIP_INDEX_URL=https://pypi.org/simple
    unset PIP_EXTRA_INDEX_URL

    python3 -m venv --system-site-packages /opt/envs/saprothub
    /opt/envs/saprothub/bin/pip install --no-cache-dir --upgrade pip 'setuptools<81' 'wheel<0.46' 'packaging<=24.2'
    base_torch=$(python3 -c 'import torch; print(torch.__version__.split("+")[0])')
    printf 'torch==%s\n' "$base_torch" >/tmp/torch-constraint.txt
    /opt/envs/saprothub/bin/pip install --no-cache-dir -c /tmp/torch-constraint.txt \
        transformers==4.43.0 safetensors==0.5.3 huggingface_hub==0.23.2 accelerate==1.8.1
    /opt/envs/saprothub/bin/pip install --no-cache-dir -c /tmp/torch-constraint.txt \
        torchmetrics==0.9.3 pytorch-lightning==2.1.3 peft==0.10.0 \
        lmdb==1.4.1 easydict==1.13 wandb==0.17.4 biopython==1.83 \
        pandas==2.2.2 matplotlib==3.9.1 Markdown==3.7

    curl --fail --location --retry 3 \
        https://mmseqs.com/foldseek/foldseek-linux-arm64.tar.gz \
        --output /tmp/foldseek-linux-arm64.tar.gz
    tar -xzf /tmp/foldseek-linux-arm64.tar.gz -C /opt
    test -x /opt/foldseek/bin/foldseek
    rm -f /tmp/foldseek-linux-arm64.tar.gz

    mkdir -p /opt/SaProtHub /models /work/cache /work/results
    tar --no-same-owner -xzf /opt/SaProtHub-selected.tar.gz -C /opt/SaProtHub
    rm -f /opt/SaProtHub-selected.tar.gz
    chmod -R a+rX /opt/SaProtHub /opt/saprothub /opt/envs/saprothub
    chmod -R a+rwx /work
    rm -rf /root/.cache/pip

%environment
    export PYTHONPATH=/opt/SaProtHub:$PYTHONPATH
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONNOUSERSITE=1
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export HF_HOME=/work/cache/huggingface
    export XDG_CACHE_HOME=/work/cache
    export TORCH_HOME=/work/cache/torch
    export TMPDIR=/tmp

%runscript
    exec /opt/envs/saprothub/bin/python /opt/saprothub/saprothub_forward.py "$@"

%test
    /opt/envs/saprothub/bin/python -c 'import platform, torch, transformers; assert platform.machine()=="aarch64"; assert torch.version.cuda; print(torch.__version__, transformers.__version__)'
    /opt/foldseek/bin/foldseek version >/dev/null
    /opt/envs/saprothub/bin/python /opt/saprothub/saprothub_forward.py --help >/dev/null
    /opt/envs/saprothub/bin/python /opt/saprothub/saprothub_extract_3di.py --help >/dev/null
    /opt/envs/saprothub/bin/python /opt/saprothub/saprothub_finetune.py --help >/dev/null
