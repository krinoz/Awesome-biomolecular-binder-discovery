Bootstrap: localimage
From: build-context/parent.sif

%files
    build-context/odesign_torch_geometric_pt24.patch /opt/odesign/odesign_torch_geometric_pt24.patch
    build-context/odesign_flash_attn_compat.patch /opt/odesign/odesign_flash_attn_compat.patch

%post
    cd /
    patch -p0 < /opt/odesign/odesign_torch_geometric_pt24.patch
    patch -p0 < /opt/odesign/odesign_flash_attn_compat.patch
    rm -f /opt/odesign/odesign_torch_geometric_pt24.patch /opt/odesign/odesign_flash_attn_compat.patch

%environment
    export PYTHONPATH=/opt/ODesign:$PYTHONPATH
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONNOUSERSITE=1
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export WANDB_MODE=offline
    export HF_HOME=/work/cache/huggingface
    export XDG_CACHE_HOME=/work/cache
    export MPLCONFIGDIR=/work/cache/matplotlib
    export TORCH_HOME=/work/cache/torch
    export TMPDIR=/tmp

%runscript
    exec /opt/envs/odesign/bin/python /opt/odesign/odesign_run.py "$@"

%test
    /opt/envs/odesign/bin/python -c 'import platform, torch; assert platform.machine()=="aarch64"; assert torch.version.cuda'
    /opt/envs/odesign/bin/python -c 'import torch_geometric, torch_scatter, torch_cluster; import src.model.odesign'
    /opt/envs/odesign/bin/python /opt/odesign/odesign_run.py --help >/dev/null
